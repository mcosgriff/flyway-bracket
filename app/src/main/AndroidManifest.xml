<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Approximate location, read once when an outing starts to find its county (#27). Never precise, never
        in the background, never saved or sent. The page before Android's prompt explains it:
        ui/home/LocationExplain.kt.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
        The league server, the project's own and the only host the app talks to (ADR 0001, #38). Nothing is
        sent before the player agrees on the consent page that League and Bracket show first.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        No Android auto-backup: outings and sightings stay on this phone until the app has its own sync.
    -->
    <application
        android:name=".FlywayApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Flyway.Starting"
        tools:targetApi="37">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
