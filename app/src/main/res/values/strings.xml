    <!-- Packs -->
    <string name="packs_title">Bird packs</string>
    <string name="packs_subtitle">A pack is one state: every county\'s birds, week by week, saved for offline use.</string>
    <string name="packs_add">Add a pack</string>
    <string name="packs_add_hint">Choose a pack file saved on this phone. Its name ends in .fbpack.</string>
    <!-- Why a chosen file was not added. -->
    <string name="packs_problem_not_a_pack">That file was not added. It is not a pack file.</string>
    <string name="packs_problem_damaged">That file was not added. It is a pack file, but part of it is missing or damaged.</string>
    <string name="packs_problem_too_new">That file was not added. It was made for a newer version of this app. Update the app, then try again.</string>
    <string name="packs_problem_too_large">That file was not added. It is too large to be a pack file.</string>
    <string name="packs_problem_not_read">That file was not added. The phone could not open it.</string>
    <string name="packs_problem_not_saved">That pack was not added. The phone could not save it. Free some space, then try again.</string>
    <string name="packs_home_title">Home state</string>
    <string name="packs_extra_title">Extra packs</string>
    <string name="packs_empty">No packs on this phone yet.</string>
