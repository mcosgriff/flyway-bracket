    <string name="packs_remove_dialog_body">Birds from %1$s can no longer be logged until you add its pack again.</string>
    <string name="packs_remove_dialog_cancel">Cancel</string>
    <!-- Where a pack's figures came from, in the words the pack file gives. -->
    <string name="packs_source">Source: %1$s</string>

