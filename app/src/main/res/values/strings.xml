    <!-- Consent: League and Bracket show it first, until the player has an account. The words say what
         docs/adr/0001-server-and-network.md says; change the two together. -->
    <string name="consent_title">Play in a league</string>
    <string name="consent_intro">Leagues, brackets and bird pack downloads need the Flyway Bracket server, the project\'s own. The app talks to it over a secure connection and to no other server. Nothing has been sent yet. If you continue, this is what will be.</string>
    <string name="consent_sent_title">What is sent</string>
    <string name="consent_sent_account">An anonymous account: an id and a secret the server gives this phone. No email, no password, no phone number. The secret is kept encrypted on this phone.</string>
    <string name="consent_sent_profile">Your display name and home county, when you set or change them.</string>
    <string name="consent_sent_leagues">The leagues you create, join or leave, and your bracket picks.</string>
    <string name="consent_sent_sightings">Each bird you log: its name, the county and the date.</string>
    <string name="consent_sent_packs">The state of each bird pack you download, and the version of it you already have, so an unchanged pack is not sent again.</string>
    <string name="consent_never_sent">Never sent: your exact location, the time of day you saw a bird, or the place names you type.</string>
    <string name="consent_seen_title">What other players see</string>
    <string name="consent_seen_body">Your display name, your picks once they lock, your points, and how many birds you logged in a round.</string>
    <string name="consent_not_seen_body">Not your county, and not your sightings.</string>
    <string name="consent_delete_title">Deleting</string>
    <string name="consent_delete_body">You can delete your account from Settings. The server then deletes your name, picks and sightings. It cannot be undone.</string>
    <string name="consent_lost_body">The account lives on this phone. If you lose the phone, reset it or clear the app\'s data, the account is lost with it.</string>
    <string name="consent_continue">Continue</string>
    <string name="consent_creating">Creating your account…</string>
    <string name="consent_try_again">Try again</string>
    <string name="consent_not_now">Not now</string>
    <string name="consent_not_now_hint">Outings work without an account, and nothing is sent.</string>

