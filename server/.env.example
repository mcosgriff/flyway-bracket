# The server's whole configuration. Copy to `server/.env` (ignored by git) and load it before
# `./gradlew :server:run`; docs/server/running.md says how. Every value here is made up and works only
# with the local Postgres that page starts. Never commit a real one.
DATABASE_URL=jdbc:postgresql://localhost:5432/flywaybracket
DATABASE_USER=flywaybracket
DATABASE_PASSWORD=made-up-local-password
PORT=8080
# The state packs: where the pack builder writes them (docs/packs.md), which git ignores. Relative to
# server/, where `./gradlew :server:run` runs. Never copy a pack into a tracked folder.
PACKS_DIR=../packs-local/out
