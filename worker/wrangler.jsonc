// The hosted league server (#16, docs/server/hosting.md): this Worker in front, the Ktor server in one
// Cloudflare container behind it. `wrangler deploy` builds ../server/Dockerfile (after
// `./gradlew :server:installDist`), pushes the image to Cloudflare's registry and deploys both.
// No secret, account id or zone id is in this file: the database values are Worker secrets, and the
// deploy job passes the account id from a GitHub secret.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flyway-bracket-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",

  // Only the custom domain: no workers.dev address and no preview URLs, so the server has one name.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "api.flywaybracket.cosgriff.io", "custom_domain": true }],

  // Every hour, to wake the server so leagues are settled on time (src/index.ts says why hourly).
  "triggers": { "crons": ["0 * * * *"] },

  "containers": [
    {
      "class_name": "FlywayServer",
      // Built with ../server as its context, where `:server:installDist` leaves build/install/server.
      "image": "../server/Dockerfile",
      // 1 GiB of memory and a quarter of a vCPU: enough for one JVM serving the beta.
      "instance_type": "basic",
      // One copy only: the rate limiter and SeasonStartJob live in the server's memory (src/index.ts).
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "SERVER", "class_name": "FlywayServer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlywayServer"] }],

  // What Cloudflare keeps about requests (docs/server/hosting.md, Watching the server; ADR 0001).
  // The Worker's own log lines go to the dashboard. Invocation logs stay off: Cloudflare's docs do not say
  // which request headers they keep, or whether they hide `Authorization`, which carries the player's
  // secret. Traces are on, for every request (sampling 1), and kept 7 days. Per Cloudflare's spans and
  // attributes page (https://developers.cloudflare.com/workers/observability/traces/spans-and-attributes/),
  // a trace of an inbound request records its method, URL and path, status, timing, user agent, ASN,
  // colo, and the country, region and city found from the IP address. Of the headers it keeps only
  // accept, accept-encoding and accept-language. It keeps no `Authorization`, no body and no IP address.
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
